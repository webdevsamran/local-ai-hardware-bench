          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "hardware_count": {
                      "type": "integer"
                    },
                    "model_count": {
                      "type": "integer"
                    },
                    "note": {
                      "type": "string"
                    },
                    "results_count": {
                      "type": "integer"
                    },
                    "runtime_count": {
                      "type": "integer"
                    },
                    "schema_version": {
                      "type": "string"
                    },
                    "source_dir": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Dataset counts and provenance."
          }
        },
        "summary": "Dataset counts and provenance.",
        "tags": [
          "stable"
        ]
      }
    },
    "/data/leaderboard.json": {
      "get": {
        "description": "Ranked views, grouped by comparison safety.\n\nA convenience view for the dashboard. Rank is *within* a comparison group and never across the dataset; do not read it as a global ranking. Shape may change when the dashboard does.\n\n**Stability: unstable.**",
        "operationId": "getLeaderboard",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "perf_watt": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "throughput": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "ttft": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Ranked views, grouped by comparison safety."
          }
        },
        "summary": "Ranked views, grouped by comparison safety.",
        "tags": [
          "convenience views"
        ]
      }
    },
    "/data/models.json": {
      "get": {
        "description": "Every benchmarked model, with formats, quantizations and checksums.\n\n**Stability: stable.**",
        "operationId": "getModels",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "checksums": {
                        "type": "array"
                      },
                      "format": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "quantizations": {
                        "type": "array"
                      },
                      "result_ids": {
                        "type": "array"
                      },
                      "zoo": {
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every benchmarked model, with formats, quantizations and checksums."
          }
        },
        "summary": "Every benchmarked model, with formats, quantizations and checksums.",
        "tags": [
          "stable"
        ]
      }
    },
    "/data/pareto.json": {
      "get": {
        "description": "Pareto-optimal points for each efficiency frontier.\n\nA convenience view for the dashboard.\n\n**Stability: unstable.**",
        "operationId": "getPareto",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "throughput_vs_latency": {
                      "properties": {
                        "excluded_missing_metrics": {
                          "type": "integer"
                        },
                        "points": {
                          "type": "array"
                        },
                        "x_higher_is_better": {
                          "type": "boolean"
                        },
                        "x_metric": {
                          "type": "string"
                        },
                        "y_higher_is_better": {
                          "type": "boolean"
                        },
                        "y_metric": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "throughput_vs_power": {
                      "properties": {
                        "excluded_missing_metrics": {
                          "type": "integer"
                        },
                        "points": {
                          "type": "array"
                        },
                        "x_higher_is_better": {
                          "type": "boolean"
                        },
                        "x_metric": {
                          "type": "string"
                        },
                        "y_higher_is_better": {
                          "type": "boolean"
                        },
                        "y_metric": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "throughput_vs_vram": {
                      "properties": {
                        "excluded_missing_metrics": {
                          "type": "integer"
                        },
                        "points": {
                          "type": "array"
                        },
                        "x_higher_is_better": {
                          "type": "boolean"
                        },
                        "x_metric": {
                          "type": "string"
                        },
                        "y_higher_is_better": {
                          "type": "boolean"
                        },
                        "y_metric": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Pareto-optimal points for each efficiency frontier."
          }
        },
        "summary": "Pareto-optimal points for each efficiency frontier.",
        "tags": [
          "convenience views"
        ]
      }
    },
    "/data/privacy.json": {
      "get": {
        "description": "The privacy scanner's pattern registry, with reference vectors.\n\nGenerated from `aihwbench/sanitize.py`. Consumers scanning results themselves should read these rather than writing their own: a second copy of the expressions eventually disagrees with the CLI about whether a file is safe to share, and nobody notices a scan that has quietly stopped catching something until a leak is published.\n\n**Stability: stable.**",
        "operationId": "getPrivacy",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "note": {
                      "type": "string"
                    },
                    "patterns": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "reference_cases": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The privacy scanner's pattern registry, with reference vectors."
          }
        },
        "summary": "The privacy scanner's pattern registry, with reference vectors.",
        "tags": [
          "stable"
        ]
      }
    },
    "/data/recommend.json": {
      "get": {
        "description": "Reference recommendations from the configuration engine.\n\nA convenience view for the dashboard's recommender, carrying reference cases that pin the browser implementation to the Python one. Recommendations themselves are computed per request, not served.\n\n**Stability: unstable.**",
        "operationId": "getRecommend",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "note": {
                      "type": "string"
                    },
                    "reference_cases": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Reference recommendations from the configuration engine."
          }
        },
        "summary": "Reference recommendations from the configuration engine.",
        "tags": [
          "convenience views"
        ]
      }
    },
    "/data/results.json": {
      "get": {
        "description": "Every published benchmark result, in full.\n\nEach element follows the versioned result schema in `schemas/`. Breaking changes go through a schema version bump and a migration, never a silent reshape.\n\n**Stability: stable.**",
        "operationId": "getResults",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "_file": {
                        "type": "string"
                      },
                      "git_commit": {
                        "type": "string"
                      },
                      "iterations": {
                        "type": "array"
                      },
                      "metrics": {
                        "type": "object"
                      },
                      "model": {
                        "type": "object"
                      },
                      "reproducibility": {
                        "type": "object"
                      },
                      "run_id": {
                        "type": "string"
                      },
                      "runtime": {
                        "type": "object"
                      },
                      "schema_version": {
                        "type": "string"
                      },
                      "system": {
                        "type": "object"
                      },
                      "timestamp": {
                        "type": "string"
                      },
                      "trust_state": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every published benchmark result, in full."
          }
        },
        "summary": "Every published benchmark result, in full.",
        "tags": [
          "stable"
        ]
      }
    },
