{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIHWBench",
  "version": "0.2.0",
  "identifier": "dev.aihwbench.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "npm --prefix ../../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "AIHWBench",
        "width": 1280,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Vendor-neutral local AI hardware benchmarking",
    "longDescription": "Measures local AI runtimes on the hardware you own, and says when two results cannot honestly be compared."
  }
}
