        },
        "summary": "Per-runtime measurements over time.",
        "tags": [
          "convenience views"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Published dataset",
      "url": "https://webdevsamran.github.io/local-ai-hardware-bench"
    }
  ],
  "tags": [
    {
      "description": "Versioned; breaking changes require a schema bump.",
      "name": "stable"
    },
    {
      "description": "Shaped for the dashboard; may change with it.",
      "name": "convenience views"
    }
  ]
}
