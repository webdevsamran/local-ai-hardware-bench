# Type checkers / coverage
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Models and large binaries - never commit
*.gguf
*.onnx
*.bin
*.safetensors
*.engine
*.trt
# Model weights are large and redistributable only under their own terms.
# `models/*` rather than `models/`: git cannot re-include a file whose parent
# directory is itself excluded, and the manifest below must be tracked.
models/*
# ...except the zoo manifest, which is the record of what was
# benchmarked, under what licence, and how to obtain it.
!models/zoo.json

# Results are committed selectively (published/ only); ignore transient state
results/raw/*.tmp

# OS / editor
Thumbs.db
.DS_Store
.idea/
.vscode/

# Secrets
.env
*.key

# Runtime compiler artifacts
*.errors.txt
