                        "f16": {
                          "type": "number"
                        },
                        "fp16": {
                          "type": "number"
                        },
                        "fp32": {
                          "type": "number"
                        },
                        "int8": {
                          "type": "number"
                        },
                        "iq2_xxs": {
                          "type": "number"
                        },
                        "iq3_xxs": {
                          "type": "number"
                        },
                        "iq4_xs": {
                          "type": "number"
                        },
                        "q2_k": {
                          "type": "number"
                        },
                        "q3_k_m": {
                          "type": "number"
                        },
                        "q3_k_s": {
                          "type": "number"
                        },
                        "q4_0": {
                          "type": "number"
                        },
                        "q4_1": {
                          "type": "number"
                        },
                        "q4_k_m": {
                          "type": "number"
                        },
                        "q4_k_s": {
                          "type": "number"
                        },
                        "q5_0": {
                          "type": "number"
                        },
                        "q5_1": {
                          "type": "number"
                        },
                        "q5_k_m": {
                          "type": "number"
                        },
                        "q5_k_s": {
                          "type": "number"
                        },
                        "q6_k": {
                          "type": "number"
                        },
                        "q8": {
                          "type": "number"
                        },
                        "q8_0": {
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "note": {
                      "type": "string"
                    },
                    "overhead_factor": {
                      "type": "number"
                    },
                    "reference_cases": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Bits-per-weight table and overhead factor for the model-fit estimator."
          }
