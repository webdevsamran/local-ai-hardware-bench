    "/data/hardware.json": {
      "get": {
        "description": "Every machine with published results, keyed by hardware fingerprint.\n\nThe fingerprint is a stable identifier for a hardware configuration.\n\n**Stability: stable.**",
        "operationId": "getHardware",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "cpu": {
                        "type": "string"
                      },
                      "fingerprint": {
                        "type": "string"
                      },
                      "gpu": {
                        "type": "string"
                      },
                      "npu": {
                        "type": "null"
                      },
                      "os": {
                        "type": "string"
                      },
                      "ram_gb": {
                        "type": "number"
                      },
                      "result_ids": {
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every machine with published results, keyed by hardware fingerprint."
          }
        },
        "summary": "Every machine with published results, keyed by hardware fingerprint.",
        "tags": [
          "stable"
        ]
      }
    },
    "/data/index.json": {
      "get": {
        "description": "Dataset counts and provenance.\n\nSmall and unlikely to change shape.\n\n**Stability: stable.**",
        "operationId": "getIndex",
