{
  "note": "Generated from aihwbench/sanitize.py, which stays canonical. Detection is regex-based and deliberately over-eager: a false positive costs a contributor a second look, while a false negative publishes someone's home directory. Every credential in reference_cases is synthetic and exists to be matched; this file is a detection corpus, not a store of secrets, so it carries the scanner's whole-file exemption: secret-scan: allow-file",
  "patterns": [
    {
      "id": "mac_address",
      "ignore_case": false,
      "label": "MAC address",
      "pattern": "(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}"
    },
    {
      "id": "ipv4",
      "ignore_case": false,
      "label": "IPv4 address",
      "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b"
    },
    {
      "id": "ipv6",
      "ignore_case": false,
      "label": "IPv6 address",
      "pattern": "\\b(?:[0-9A-Fa-f]{1,4}:){2,7}[0-9A-Fa-f]{0,4}\\b"
    },
    {
      "id": "ssn",
      "ignore_case": false,
      "label": "SSN",
      "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b"
    },
    {
      "id": "token_or_credential",
      "ignore_case": false,
      "label": "possible token/credential",
      "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}\\b|Bearer\\s+[A-Za-z0-9._~+/=-]{10,})"
    },
    {
      "id": "cloud_access_key",
      "ignore_case": false,
      "label": "cloud access key id",
      "pattern": "\\b(?:AKIA|ASIA|AROA|AIDA|ANPA|ANVA|AIPA)[0-9A-Z]{12,}\\b"
    },
    {
      "id": "api_key",
      "ignore_case": false,
      "label": "API key",
      "pattern": "\\b(?:sk|pk|rk)-[A-Za-z0-9_-]{16,}\\b"
    },
    {
      "id": "windows_path",
      "ignore_case": true,
      "label": "Windows user home path",
      "pattern": "[A-Za-z]:[\\\\/]+Users[\\\\/]+[^\\\"'\\\\/\\s]+"
    },
    {
      "id": "home_path",
      "ignore_case": true,
      "label": "home directory",
      "pattern": "(?:[\\\\/]{1,2})home(?:[\\\\/]{1,2})[A-Za-z0-9._-]+"
    },
    {
      "id": "macos_home_path",
      "ignore_case": false,
      "label": "macOS home directory",
      "pattern": "(?<![A-Za-z0-9]):?[\\\\/]Users[\\\\/][^\\\"'\\\\/\\s]+"
    },
    {
      "id": "serial_number",
      "ignore_case": true,
      "label": "serial number",
      "pattern": "\\bserial\\s*(?:number|no|#)?\\s*[:=]\\s*[A-Za-z0-9]+"
    },
    {
      "id": "serial_like",
      "ignore_case": false,
      "label": "serial-like identifier",
      "pattern": "\\bSN[-:]?\\s?[0-9A-Z]{8,}\\b"
    },
    {
      "id": "username_placeholder",
      "ignore_case": true,
      "label": "username placeholder",
      "pattern": "\\bUSERNAME\\b"
    },
    {
      "id": "email",
      "ignore_case": false,
      "label": "email address",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
    }
  ],
